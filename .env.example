# ============================================================
#  Kopiraj ovaj fajl u .env.local i popuni vrednosti.
#  Sve je opciono — sajt radi i bez ovoga, ali će zakazivanje
#  prikazivati da slanje nije aktivirano.
# ============================================================

# --- Sajt ---
# Pun domen (podrazumevano: https://www.djurdjevictatto.com). Menjaj samo ako se domen promeni.
NEXT_PUBLIC_SITE_URL=

# --- Kontakt podaci (mogu se menjati i direktno u src/config/site.ts) ---
# Instagram korisničko ime (bez @) ili pun link do profila
NEXT_PUBLIC_INSTAGRAM=
# Broj telefona u međunarodnom formatu, npr. +381 60 000 0000
NEXT_PUBLIC_PHONE=
# Adresa studija (koristi se i za Google Maps navigaciju)
NEXT_PUBLIC_ADDRESS=

# --- Slanje zahteva za termin: izaberi JEDAN način ---

# Opcija 1: Email preko Resend-a (https://resend.com)
RESEND_API_KEY=
BOOKING_TO_EMAIL=
BOOKING_FROM_EMAIL=

# Opcija 2: Webhook (Make, Zapier, n8n, sopstvena baza...)
BOOKING_WEBHOOK_URL=
# Postavi na true ako webhook treba da primi i sadržaj referentne fotografije (base64)
BOOKING_WEBHOOK_INCLUDE_FILE=false
